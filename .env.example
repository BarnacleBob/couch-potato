# Copy this file to .env and paste your Anthropic API key after the = sign (no quotes).
ANTHROPIC_API_KEY=

# Model that picks videos. Default is Claude Opus 5.5.
# claude-haiku-5-5 is far cheaper and probably plenty for this job.
CLAUDE_MODEL=claude-opus-5-5

PORT=8787

# Your timezone, for Docker (containers default to UTC). Claude uses the time of day when picking.
# Examples: America/New_York, America/Chicago, America/Los_Angeles, Europe/London
TZ=America/New_York
